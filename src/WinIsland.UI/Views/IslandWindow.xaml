<Window x:Class="WinIsland.UI.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WinIsland.UI.Models"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="240" Height="42" Title="Nexo" Icon="/Assets/logo.png"
        Loaded="Window_Loaded" Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ═══  AMD ADRENALINE-INSPIRED STYLES                ═══ -->
        <!-- ═══════════════════════════════════════════════════ -->

        <!-- ═══ SLIDER (red track) ═══ -->
        <Style x:Key="NexoSlider" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" OverridesDefaultStyle="True">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Border Background="#ED1C24" CornerRadius="2" Height="4"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb OverridesDefaultStyle="True" Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="White" Width="14" Height="14">
                                                    <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.5" Color="#ED1C24"/></Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" OverridesDefaultStyle="True">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Border Background="#1E1E1E" CornerRadius="2" Height="4"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ MODULE CARD (angular, AMD style) ═══ -->
        <Style x:Key="ModuleCardButton" TargetType="Button">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E1E1E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="3" MinHeight="68" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A1A"/>
                                <Setter Property="BorderBrush" Value="#ED1C24"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#222222"/>
                                <Setter Property="BorderBrush" Value="#FF2D35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ICON BUTTON ═══ -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" MinWidth="40" MinHeight="40">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A1A1A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#242424"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ PILL BUTTON (angular) ═══ -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1C1C1C"/>
                                <Setter Property="BorderBrush" Value="#ED1C24"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ACTION BUTTON (red accent) ═══ -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#ED1C24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF2D35"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#C41920"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ SMALL PILL (text tool ops) ═══ -->
        <Style x:Key="SmallPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Border x:Name="IslandBorder" CornerRadius="10" Background="#F0060606"
                BorderBrush="#18FFFFFF" BorderThickness="1" Cursor="Hand"
                MouseLeftButtonUp="OnIslandClick" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
            <Border.Effect>
                <DropShadowEffect Color="#ED1C24" BlurRadius="16" ShadowDepth="0" Opacity="0.15"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- ╔══════════════════════════════════════════╗ -->
                <!-- ║            COMPACT VIEW                  ║ -->
                <!-- ╚══════════════════════════════════════════╝ -->
                <Grid x:Name="CompactView" Opacity="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/Assets/logo.png" Width="18" Height="18" Margin="0,0,8,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding CurrentTime}"
                                   Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display,Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                                                         From="0.2" To="1" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0"/>
                                        <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                                                         From="0.2" To="1" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                                                         From="0.2" To="1" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                        <Ellipse x:Name="Dot1" Width="3.5" Height="3.5" Fill="#ED1C24" Margin="2,0" Opacity="0.2"/>
                        <Ellipse x:Name="Dot2" Width="3.5" Height="3.5" Fill="#ED1C24" Margin="2,0" Opacity="0.2"/>
                        <Ellipse x:Name="Dot3" Width="3.5" Height="3.5" Fill="#ED1C24" Margin="2,0" Opacity="0.2"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding CompactStatus}"
                               Foreground="#808080" FontSize="11" FontFamily="Segoe UI"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>

                <!-- ╔══════════════════════════════════════════╗ -->
                <!-- ║           EXPANDED VIEW                  ║ -->
                <!-- ╚══════════════════════════════════════════╝ -->
                <Grid x:Name="ExpandedView" Opacity="0" IsHitTestVisible="False" Margin="18,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── NAV HEADER ── -->
                    <Grid Grid.Row="0" Margin="0,2,0,6">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnHomePage}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Button HorizontalAlignment="Left" Style="{StaticResource IconButton}"
                                Command="{Binding NavigateHomeCommand}" FontSize="13" Padding="6"
                                Content="&#xE72B;" MinWidth="30" MinHeight="30"/>
                        <!-- Red accent line + Title -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="3" Height="14" Background="#ED1C24" CornerRadius="1" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding PageTitle}" Foreground="White" FontSize="14"
                                       FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Grid>

                    <!-- ═══════════ HOME PAGE ═══════════ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="home">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Clock + Date + Logo Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Image Source="/Assets/logo.png" Width="16" Height="16" Margin="0,0,6,0"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="N E X O" Foreground="#ED1C24" FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentTime}" Foreground="White" FontSize="42"
                                       FontWeight="Light" FontFamily="Segoe UI Variable Display,Segoe UI"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CurrentDate}" Foreground="#666666" FontSize="12"
                                       FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- System Monitor Card -->
                        <Border Grid.Row="1" Background="#111111" CornerRadius="6" Padding="14,12"
                                Margin="0,0,0,10" BorderBrush="#1E1E1E" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="3" Height="10" Background="#ED1C24" CornerRadius="1" Margin="0,0,8,0"/>
                                    <TextBlock Text="SYSTEM" Foreground="#666666" FontSize="10"
                                               FontWeight="Bold" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <!-- CPU -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" Height="4" Margin="8,0">
                                        <Border Background="#1E1E1E" CornerRadius="2"/>
                                        <Border Background="#ED1C24" CornerRadius="2" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform ScaleX="{Binding CpuDecimal}"/></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding CpuUsageText}" Foreground="#808080" FontSize="10.5"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                                <!-- RAM -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" Height="4" Margin="8,0">
                                        <Border Background="#1E1E1E" CornerRadius="2"/>
                                        <Border Background="#30D158" CornerRadius="2" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform ScaleX="{Binding RamDecimal}"/></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding RamUsageText}" Foreground="#808080" FontSize="10.5"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Module Grid 2×4 -->
                        <UniformGrid Grid.Row="2" Columns="4" Rows="2">
                            <Button Style="{StaticResource ModuleCardButton}" Command="{Binding NavigateCommand}" CommandParameter="music">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Music" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardButton}" Command="{Binding NavigateCommand}" CommandParameter="controls">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7F3;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Controls" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardButton}" Command="{Binding NavigateCommand}" CommandParameter="timer">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Timer" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardButton}" Command="{Binding NavigateCommand}" CommandParameter="clipboard">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Clipboard" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardButton}" Command="{Binding NavigateCommand}" CommandParameter="notes">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Notes" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardButton}" Command="{Binding NavigateCommand}" CommandParameter="texttool">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Text Tool" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardButton}" Command="{Binding NavigateCommand}" CommandParameter="calendar">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Calendar" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModuleCardButton}" IsEnabled="False" Opacity="0.3">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Settings" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>

                    <!-- ═══════════ MUSIC PAGE ═══════════ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="music">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel VerticalAlignment="Center">
                            <Border Background="#111111" CornerRadius="8" Width="140" Height="140"
                                    HorizontalAlignment="Center" Margin="0,0,0,22"
                                    BorderBrush="#1E1E1E" BorderThickness="1">
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                           Foreground="#ED1C24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding MediaTitle}" Foreground="White" FontSize="17"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding MediaArtist}" Foreground="#808080" FontSize="13"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="380" Margin="0,0,0,24"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE892;"
                                        Command="{Binding PrevTrackCommand}" FontSize="20" Margin="6,0"/>
                                <Button Style="{StaticResource IconButton}" Content="{Binding PlayPauseIcon}"
                                        Command="{Binding PlayPauseCommand}" FontSize="26" Margin="6,0"
                                        MinWidth="52" MinHeight="52"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE893;"
                                        Command="{Binding NextTrackCommand}" FontSize="20" Margin="6,0"/>
                            </StackPanel>
                            <TextBlock Foreground="#4A4A4A" FontSize="11" HorizontalAlignment="Center"
                                       Margin="0,16,0,0" FontFamily="Segoe UI">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveMedia}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Text" Value="Play something to see it here"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- ═══════════ TIMER PAGE ═══════════ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="timer">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel VerticalAlignment="Top" Margin="0,6,0,0">
                            <TextBlock Text="{Binding TimerDisplay}" Foreground="White" FontSize="52"
                                       FontWeight="Light" FontFamily="Segoe UI Variable Display,Segoe UI"
                                       HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Button Style="{StaticResource PillButton}" Content="5m"
                                        Command="{Binding SetTimerPresetCommand}" CommandParameter="5" Margin="2,0"/>
                                <Button Style="{StaticResource PillButton}" Content="10m"
                                        Command="{Binding SetTimerPresetCommand}" CommandParameter="10" Margin="2,0"/>
                                <Button Style="{StaticResource PillButton}" Content="15m"
                                        Command="{Binding SetTimerPresetCommand}" CommandParameter="15" Margin="2,0"/>
                                <Button Style="{StaticResource PillButton}" Content="25m"
                                        Command="{Binding SetTimerPresetCommand}" CommandParameter="25" Margin="2,0"/>
                                <Button Style="{StaticResource PillButton}" Content="30m"
                                        Command="{Binding SetTimerPresetCommand}" CommandParameter="30" Margin="2,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Button Style="{StaticResource ActionButton}" Content="{Binding TimerButtonText}"
                                        Command="{Binding ToggleTimerCommand}" Margin="4,0"/>
                                <Button Style="{StaticResource PillButton}" Content="Reset"
                                        Command="{Binding ResetTimerCommand}" Margin="4,0" Padding="16,8"/>
                            </StackPanel>

                            <Border Background="#1E1E1E" Height="1" Margin="16,0,16,16"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Border Width="3" Height="10" Background="#ED1C24" CornerRadius="1" Margin="0,0,8,0"/>
                                <TextBlock Text="STOPWATCH" Foreground="#666666" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StopwatchDisplay}" Foreground="White" FontSize="32"
                                       FontWeight="Light" FontFamily="Segoe UI Variable Display,Segoe UI"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource ActionButton}" Content="{Binding StopwatchButtonText}"
                                        Command="{Binding ToggleStopwatchCommand}" Margin="4,0"/>
                                <Button Style="{StaticResource PillButton}" Content="Reset"
                                        Command="{Binding ResetStopwatchCommand}" Margin="4,0" Padding="16,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ═══════════ CONTROLS PAGE ═══════════ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="controls">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel VerticalAlignment="Top" Margin="0,6,0,0">
                            <Border Background="#111111" CornerRadius="6" Padding="14,12" Margin="0,0,0,10"
                                    BorderBrush="#1E1E1E" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding VolumeIcon}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="Volume" Foreground="#CCC" FontSize="12.5" Margin="26,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding VolumeText}" Foreground="#808080" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider Grid.Row="1" Style="{StaticResource NexoSlider}"
                                            Value="{Binding Volume, Mode=TwoWay}" Margin="0,0,0,2"/>
                                </Grid>
                            </Border>

                            <Button Style="{StaticResource PillButton}" HorizontalAlignment="Left"
                                    Command="{Binding ToggleMuteCommand}" Margin="0,0,0,16" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding MuteButtonIcon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding MuteButtonText}" Foreground="#CCC" FontSize="11.5"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="3" Height="10" Background="#ED1C24" CornerRadius="1" Margin="0,0,8,0"/>
                                <TextBlock Text="POWER" Foreground="#666666" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <UniformGrid Columns="4">
                                <Button Style="{StaticResource ModuleCardButton}" Command="{Binding LockCommand}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Lock" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModuleCardButton}" Command="{Binding SleepCommand}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xEC46;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sleep" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModuleCardButton}" Command="{Binding RestartCommand}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FF9F0A" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Restart" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModuleCardButton}" Command="{Binding ShutdownCommand}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FF453A" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Shut down" Foreground="#808080" FontSize="9.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <!-- ═══════════ CLIPBOARD PAGE ═══════════ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="clipboard">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding ClipboardHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ClipboardItem}">
                                        <Border Background="#111111" CornerRadius="5" Margin="0,0,0,4" Padding="10,8"
                                                Cursor="Hand" BorderBrush="#1E1E1E" BorderThickness="1">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                    Command="{Binding DataContext.PasteClipboardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Preview}" Foreground="#CCC" FontSize="11.5"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding TimeText}" Foreground="#4A4A4A" FontSize="9.5" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                        Content="{Binding PinIcon}" FontSize="12"
                                                        MinWidth="28" MinHeight="28" Padding="4"
                                                        Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="1" Style="{StaticResource PillButton}" Content="Clear Unpinned"
                                Command="{Binding ClearClipboardCommand}" HorizontalAlignment="Center"
                                Margin="0,6,0,2" Padding="14,7"/>
                    </Grid>

                    <!-- ═══════════ NOTES PAGE ═══════════ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="notes">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border Background="#111111" CornerRadius="6" Padding="2" Margin="0,4,0,0"
                                BorderBrush="#1E1E1E" BorderThickness="1">
                            <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="#DDD" FontSize="12.5"
                                     FontFamily="Segoe UI" BorderThickness="0"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Padding="12,10"
                                     CaretBrush="#ED1C24" SelectionBrush="#ED1C24">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>
                    </Grid>

                    <!-- ═══════════ TEXT TOOL PAGE ═══════════ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="texttool">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#111111" CornerRadius="5" Margin="0,4,0,6"
                                BorderBrush="#1E1E1E" BorderThickness="1">
                            <TextBox Text="{Binding TextInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="#DDD" FontSize="12"
                                     FontFamily="Consolas,Segoe UI" BorderThickness="0"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                     VerticalScrollBarVisibility="Auto" Padding="10,8"
                                     CaretBrush="#ED1C24" SelectionBrush="#ED1C24">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>

                        <Button Grid.Row="1" Style="{StaticResource PillButton}" Content="📋 Paste"
                                Command="{Binding TextFromClipboardCommand}"
                                HorizontalAlignment="Left" Margin="0,0,0,6" Padding="10,4" FontSize="10.5"/>

                        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                            <Button Style="{StaticResource SmallPillButton}" Content="UPPER" Command="{Binding TextUpperCommand}" Margin="0,0,3,3"/>
                            <Button Style="{StaticResource SmallPillButton}" Content="lower" Command="{Binding TextLowerCommand}" Margin="0,0,3,3"/>
                            <Button Style="{StaticResource SmallPillButton}" Content="Title" Command="{Binding TextTitleCommand}" Margin="0,0,3,3"/>
                            <Button Style="{StaticResource SmallPillButton}" Content="Count" Command="{Binding TextCountCommand}" Margin="0,0,3,3"/>
                            <Button Style="{StaticResource SmallPillButton}" Content="JSON" Command="{Binding TextJsonCommand}" Margin="0,0,3,3"/>
                            <Button Style="{StaticResource SmallPillButton}" Content="B64↑" Command="{Binding TextBase64EncCommand}" Margin="0,0,3,3"/>
                            <Button Style="{StaticResource SmallPillButton}" Content="B64↓" Command="{Binding TextBase64DecCommand}" Margin="0,0,3,3"/>
                        </WrapPanel>

                        <Border Grid.Row="3" Background="#111111" CornerRadius="5"
                                BorderBrush="#1E1E1E" BorderThickness="1">
                            <TextBox Text="{Binding TextResult, Mode=OneWay}" IsReadOnly="True"
                                     Background="Transparent" Foreground="#ED1C24" FontSize="12"
                                     FontFamily="Consolas,Segoe UI" BorderThickness="0"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10,8">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>

                        <Button Grid.Row="4" Style="{StaticResource ActionButton}" Content="📋 Copy Result"
                                Command="{Binding TextCopyResultCommand}"
                                HorizontalAlignment="Center" Margin="0,6,0,2" Padding="14,7" FontSize="11.5"/>
                    </Grid>

                    <!-- ═══════════ CALENDAR PAGE ═══════════ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="calendar">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel Margin="0,6,0,0">
                            <!-- Month navigation -->
                            <Grid Margin="0,0,0,14">
                                <Button Style="{StaticResource IconButton}" Content="&#xE76B;"
                                        Command="{Binding CalendarPrevCommand}" HorizontalAlignment="Left"
                                        FontSize="13" MinWidth="32" MinHeight="32" Padding="4"/>
                                <TextBlock Text="{Binding CalendarTitle}" Foreground="White" FontSize="15"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE76C;"
                                        Command="{Binding CalendarNextCommand}" HorizontalAlignment="Right"
                                        FontSize="13" MinWidth="32" MinHeight="32" Padding="4"/>
                            </Grid>

                            <!-- Day-of-week headers -->
                            <UniformGrid Columns="7" Margin="0,0,0,6">
                                <TextBlock Text="Mo" Foreground="#4A4A4A" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Tu" Foreground="#4A4A4A" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="We" Foreground="#4A4A4A" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Th" Foreground="#4A4A4A" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Fr" Foreground="#4A4A4A" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Sa" Foreground="#4A4A4A" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Su" Foreground="#4A4A4A" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </UniformGrid>

                            <ItemsControl ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CalendarDay}">
                                        <Grid Height="34" Width="34" HorizontalAlignment="Center">
                                            <!-- Today highlight -->
                                            <Border Width="28" Height="28" CornerRadius="4"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Background" Value="#ED1C24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding Day}" FontSize="12.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#CCC"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                <Setter Property="Foreground" Value="#2A2A2A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
