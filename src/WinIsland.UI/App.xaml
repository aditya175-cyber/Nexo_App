<Application x:Class="WinIsland.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/IslandWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ═══ AMD ADRENALINE-INSPIRED COLOR PALETTE ═══ -->
            <SolidColorBrush x:Key="IslandBgBrush" Color="#0A0A0A" />
            <SolidColorBrush x:Key="AccentRedBrush" Color="#ED1C24" />
            <SolidColorBrush x:Key="AccentRedHoverBrush" Color="#FF2D35" />
            <SolidColorBrush x:Key="AccentRedDimBrush" Color="#991018" />
            <SolidColorBrush x:Key="AccentGreenBrush" Color="#30D158" />
            <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FF9F0A" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF453A" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#808080" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#4A4A4A" />
            <SolidColorBrush x:Key="CardBgBrush" Color="#141414" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="CardActiveBrush" Color="#242424" />
            <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
